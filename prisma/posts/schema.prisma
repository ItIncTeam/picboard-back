generator client {
  provider = "prisma-client-js"
  output   = "../apps/posts/src/generated/prisma/posts-client"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id          String           @id @default(uuid())
  ownerId     String
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  attachments PostAttachment[]

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([deletedAt])
}

model PostAttachment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  fileId    String
  sortOrder Int
  createdAt DateTime @default(now())

  @@unique([postId, fileId])
  @@unique([postId, sortOrder])
  @@index([fileId])
}

enum OutboxStatus {
  PENDING
  DONE
  FAILED
}

// Transactional outbox: задача «при удалении поста удалить его файлы в files-сервисе».
// Запись создаётся в одной транзакции с soft-delete поста; фоновый воркер
// доставляет её в files с ретраями (at-least-once, идемпотентно).
model FileDeletionOutbox {
  id            String       @id @default(uuid())
  postId        String
  ownerId       String
  fileIds       String[]
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?
  nextAttemptAt DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  processedAt   DateTime?

  @@index([status, nextAttemptAt])
}
